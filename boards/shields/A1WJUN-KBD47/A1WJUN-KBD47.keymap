#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/behaviors.h>

// 鼠标移动与滚轮的默认速度值（覆盖默认的 600 10）
#undef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <dt-bindings/zmk/pointing.h>

/*
 * 层索引定义（共32层，Layer10-Layer31 为预留扩展层）
 */
#define Base        0
#define Number      1
#define Function    2
#define Bluetooth   3
#define Symbols     4
#define Media       5
#define Navigation  6
#define Mouse       7
#define System      8
#define Button      9

/ {
    /*
     * ========================================
     * 行为 (Behaviors) 定义
     * ========================================
     */

    behaviors {
        /*
         * mod_tap (Mod-Tap 行为)
         */
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };

        /*
         * layer_tap (Layer-Tap 行为)
         */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        /*
         * tap_dance_esc (ESC Tap Dance)
         * 单击 = ESC，双击 = MUTE
         */
        td_esc: tap_dance_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance ESC";
        };

         /*
         * tap_dance_q (Q Tap Dance)
         * 单击 = Q，双击 = 1
         */
        td_q: tap_dance_q {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance Q";
        };

         /*
         * tap_dance_w (W Tap Dance)
         * 单击 = W，双击 = 2
         */
        td_w: tap_dance_w {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance W";
        };

         /*
         * tap_dance_e (E Tap Dance)
         * 单击 = E，双击 = 3
         */
        td_e: tap_dance_e {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance E";
        };

         /*
         * tap_dance_r (R Tap Dance)
         * 单击 = R，双击 = 4
         */
        td_r: tap_dance_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance R";
        };
         /*
         * tap_dance_t (T Tap Dance)
         * 单击 = T，双击 = 5
         */
        td_t: tap_dance_t {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance T";
        };

         /*
         * tap_dance_y (Y Tap Dance)
         * 单击 = Y，双击 = 6
         */
        td_y: tap_dance_y {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance Y";
        };

         /*
         * tap_dance_u (U Tap Dance)
         * 单击 = U，双击 = 7
         */
        td_u: tap_dance_u {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance U";
        };

         /*
         * tap_dance_i (I Tap Dance)
         * 单击 = I，双击 = 8
         */
        td_i: tap_dance_i {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance I";
        };
         /*
         * tap_dance_o (O Tap Dance)
         * 单击 = O，双击 = 9
         */
        td_o: tap_dance_o {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance O";
        };

         /*
         * tap_dance_p (P Tap Dance)
         * 单击 = P，双击 = 0
         */
        td_p: tap_dance_p {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance P";
        };

        /*
         * tap_dance_tab (TAB Tap Dance)
         * 单击 = TAB，双击 = CAPSLOCK
         */
        td_tab: tap_dance_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance TAB";
        };

        /*
         * scroll_ud (编码器滚动行为)
         */
        scroll_ud: behavior_scroll_ud {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        /*
         * encoder_click_esc (编码器点击 - ESC功能)
         * 单击 = ESC，双击 = ` (与 col0 row0 相同)
         */
        encoder_click_esc: encoder_click_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&kp>, <&kp>;
            display-name = "Encoder Click ESC";
        };

        /*
         * encoder_brightness (编码器亮度调节)
         */
        encoder_brightness: behavior_brightness {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_BRI_DN>, <&kp C_BRI_UP>;
            tap-ms = <20>;
        };

        /*
         * encoder_media (编码器媒体控制)
         */
        encoder_media: behavior_media {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_PREV>, <&kp C_NEXT>;
            tap-ms = <20>;
        };

        /*
         * encoder_bt_switch (编码器蓝牙切换)
         */
        encoder_bt_switch: behavior_bt_switch {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_PRV>, <&bt BT_NXT>;
            tap-ms = <1>;
        };
    };

    /*
     * ========================================
     * 宏 (Macros) 定义
     * ========================================
     */
    macros {
        // 一键输入邮箱地址（实用宏示例）
        email_macro: email_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp N1>, <&kp W>, <&kp I>, <&kp L>, <&kp L>, <&kp I>, <&kp A>, <&kp M>, <&kp DOT>, <&kp W>, <&kp A>, <&kp N>, <&kp G>, <&kp AT>, <&kp G>, <&kp M>, <&kp A>, <&kp I>, <&kp L>, <&kp DOT>, <&kp C>, <&kp O>, <&kp M>;
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };
};

/*
 * ========================================
 * 鼠标移动与滚轮加速配置 - 优化版
 * ========================================
 */

// 鼠标移动行为（指针移动）- 更快响应
&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <200>;          // 优化：300ms → 200ms（更快响应）
    acceleration-exponent = <1>;
    delay-ms = <0>;
};

// 鼠标滚轮行为
&msc {
    x-input-code = <INPUT_REL_HWHEEL>;
    y-input-code = <INPUT_REL_WHEEL>;
    time-to-max-speed-ms = <200>;          // 优化：300ms → 200ms
    acceleration-exponent = <0>;
    delay-ms = <0>;
};

// 软关机行为
&soft_off {
    hold-time-ms = <5000>;
};

/ {
    /*
     * ========================================
     * 按键映射 (Keymap)
     * ========================================
     */
    keymap {
        compatible = "zmk,keymap";

        /*
         * ========================================
         * 层 0：Base（基础层）- 最终优化版
         * ========================================
         * 
         * 注意：display-name 最大 20 字符，只使用字母、数字、下划线
         */
        layer_base {
            display-name = "Base 0";
            bindings = <
                // 第 1 行（12 键）- ESC 和 TAB 使用 Tap Dance
                &td_esc ESC C_MUTE &td_q Q N1    &td_w W N2    &td_e E N3    &td_r R N4    &td_t T N5    &td_y Y N6    &td_u U N7    &td_i I N8    &td_o O N9   &td_p P N0      &kp BACKSPACE
                // 第 2 行（12 键）- TAB 使用 Tap Dance
                &td_tab TAB CAPS   &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         &kp J         &kp K         &kp L         &kp SLASH      &kp ENTER
                // 第 3 行（12 键）- DEL 激活 Navigation 层，↑ 激活 System 层
                &kp LSHFT        &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         &kp M         &kp COMMA     &kp DOT       &lt 6 UP       &lt 8 DEL
                // 第 4 行（11 键）- 右 Alt 激活 Symbols 层
                &lt 3 LCTRL      &kp LGUI    &kp LALT    &kp C_VOL_DN  &kp C_PP    &lt 1 SPACE   &lt 2 SPACE   &kp C_VOL_UP    &kp LEFT      &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 1：Number（数字与符号层）- 优化布局
         * ========================================
         */
        layer_number {
            display-name = "Number 1";
            bindings = <
                // 第 1 行：数字行 + 滚轮上滚
                &trans        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0        &trans
                // 第 2 行：符号优化布局
                &kp CAPS      &kp C_BRI_UP   &none          &none          &none          &none          &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp NUBS       &trans
                // 第 3 行：鼠标移动
                &kp RSHFT     &kp C_BRI_DN   &none          &none          &none          &none          &kp SEMI       &kp APOS       &mkp MB4       &mkp LCLK       &mmv MOVE_UP   &mkp RCLK
                // 第 4 行：鼠标点击
                &lt 3 RCTRL   &kp RGUI       &kp RALT       &kp PSCRN      &kp KP_NUM     &none          &mkp MCLK      &mkp MB4       &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;
            sensor-bindings = <&encoder_brightness>;
        };

        /*
         * ========================================
         * 层 2：Function（功能键层）
         * ========================================
         */
        layer_function {
            display-name = "Function 2";
            bindings = <
                // 第 1 行：F1-F12
                &kp F11         &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F12
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：导航键
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &kp PAGE_UP    &none
                // 第 4 行：导航键
                &none           &none          &none          &none          &none          &none          &none          &none          &kp HOME       &kp PAGE_DOWN   &kp END
            >;
            sensor-bindings = <&encoder_media>;
        };

        /*
         * ========================================
         * 层 3：Bluetooth（蓝牙层）
         * ========================================
         */
        layer_bluetooth {
            display-name = "Bluetooth 3";
            bindings = <
                // 第 1 行：软关机 + 蓝牙断开
                &soft_off       &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none
                // 第 2 行：蓝牙清除 + 选择设备
                &none           &out OUT_USB   &out OUT_BLE   &out OUT_TOG   &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：清除所有配对、系统复位、进入刷机模式、Studio 解锁
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 4 行：空
                &none           &none          &none          &none          &encoder_click_esc ESC C_MUTE  &none          &bt BT_CLR_ALL &bt BT_CLR     &sys_reset     &bootloader    &studio_unlock         
            >;
            sensor-bindings = <&encoder_bt_switch>;
        };

        /*
         * ========================================
         * 层 4：Symbols（符号层）- 已激活
         * ========================================
         * 通过 Base 层右 Alt 按住激活
         */
        layer_symbols {
            display-name = "Symbols 4";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&scroll_ud>;
        };

        /*
         * ========================================
         * 层 5：Media（媒体层）
         * ========================================
         */
        layer_media {
            display-name = "Media 5";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 6：Navigation（导航层）- 已激活
         * ========================================
         * 通过 Base 层 DEL 按住激活
         */
        layer_navigation {
            display-name = "Navigation 6";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 7：Mouse（鼠标层）
         * ========================================
         */
        layer_mouse {
            display-name = "Mouse 7";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 8：System（系统层）- 已激活
         * ========================================
         * 通过 Base 层 ↑ 按住激活
         * 注意：devicetree 不支持 LGUI(x) 等嵌套修饰键语法
         * Windows 快捷键可通过 ZMK Studio 在线配置
         */
        layer_system {
            display-name = "System 8";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 9：Button（蓝牙与系统控制层）
         * ========================================
         */
        layer_button {
            display-name = "Button 9";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 预留层 10-31（空层，供未来扩展或 ZMK Studio 动态配置）
         * ========================================
         */
        layer_reserved_10 {
            display-name = "Layer 10";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_11 {
            display-name = "Layer 11";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_12 {
            display-name = "Layer 12";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_13 {
            display-name = "Layer 13";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_14 {
            display-name = "Layer 14";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_15 {
            display-name = "Layer 15";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_16 {
            display-name = "Layer 16";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_17 {
            display-name = "Layer 17";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_18 {
            display-name = "Layer 18";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_reserved_19 {
            display-name = "Layer 19";
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
