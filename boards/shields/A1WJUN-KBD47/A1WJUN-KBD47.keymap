#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/behaviors.h>

// 鼠标移动与滚轮的默认速度值（覆盖默认的 600 10）
#undef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <dt-bindings/zmk/pointing.h>

/*
 * 层索引定义（共10层）
 */
#define Base        0
#define Number      1
#define Function    2
#define Button      3
#define Symbols     4
#define Media       5
#define Navigation  6
#define Mouse       7
#define System      8
#define Bluetooth   9

/ {
    /*
     * ========================================
     * 行为 (Behaviors) 定义
     * ========================================
     */

    behaviors {
        /*
         * mod_tap (Mod-Tap 行为)
         */
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };

        /*
         * layer_tap (Layer-Tap 行为)
         */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };

        /*
         * tap_dance_esc (ESC Tap Dance)
         * 单击 = ESC，双击 = ` (反引号)
         */
        td_esc: tap_dance_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance ESC";
        };

        /*
         * tap_dance_tab (TAB Tap Dance)
         * 单击 = TAB，双击 = CAPSLOCK
         */
        td_tab: tap_dance_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance TAB";
        };

        /*
         * scroll_ud (编码器滚动行为)
         */
        scroll_ud: behavior_scroll_ud {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        /*
         * encoder_brightness (编码器亮度调节)
         */
        encoder_brightness: behavior_brightness {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_BRI_DN>, <&kp C_BRI_UP>;
            tap-ms = <20>;
        };

        /*
         * encoder_media (编码器媒体控制)
         */
        encoder_media: behavior_media {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_PREV>, <&kp C_NEXT>;
            tap-ms = <20>;
        };

        /*
         * encoder_bt_switch (编码器蓝牙切换)
         */
        encoder_bt_switch: behavior_bt_switch {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_PRV>, <&bt BT_NXT>;
            tap-ms = <20>;
        };
    };

    /*
     * ========================================
     * 宏 (Macros) 定义
     * ========================================
     */
    macros {
        // 一键输入 "Hello"
        hello_macro: hello_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bind = <&kp H>, <&kp E>, <&kp L>, <&kp L>, <&kp O>;
            wait-ms = <10>;
            tap-ms = <10>;
        };
    };
};

/*
 * ========================================
 * 鼠标移动与滚轮加速配置 - 优化版
 * ========================================
 */

// 鼠标移动行为（指针移动）- 更快响应
&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <200>;          // 优化：300ms → 200ms（更快响应）
    acceleration-exponent = <1>;
    delay-ms = <0>;
};

// 鼠标滚轮行为
&msc {
    x-input-code = <INPUT_REL_HWHEEL>;
    y-input-code = <INPUT_REL_WHEEL>;
    time-to-max-speed-ms = <200>;          // 优化：300ms → 200ms
    acceleration-exponent = <0>;
    delay-ms = <0>;
};

// 软关机行为
&soft_off {
    hold-time-ms = <5000>;
};

/ {
    /*
     * ========================================
     * 按键映射 (Keymap)
     * ========================================
     */
    keymap {
        compatible = "zmk,keymap";

        /*
         * ========================================
         * 层 0：Base（基础层）- 最终优化版
         * ========================================
         * 
         * 底层快捷键：
         *   - ESC 单击=ESC，双击=` (Tap Dance)
         *   - TAB 单击=TAB，双击=CAPS (Tap Dance)
         *   - 左 Ctrl 按住 → 层 7（Mouse）
         *   - 左 Alt 按住 → 层 2（Function）
         *   - 右拇指上键 按住 → 层 5（Media）
         *   - 右拇指下键 按住 → 层 9（Bluetooth）
         *   - 空格按住 → 层 1（Number）
         *   - 右 Alt 按住 → 层 4（Symbols）
         *   - DEL 按住 → 层 6（Navigation）
         *   - ↑ 按住 → 层 8（System）
         */
        layer_base {
            display-name = "Base";
            bindings = <
                // 第 1 行（12 键）- ESC 和 TAB 使用 Tap Dance
                &td_esc ESC      &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         &kp U         &kp I         &kp O         &kp P          &kp BACKSPACE
                // 第 2 行（12 键）- TAB 使用 Tap Dance
                &td_tab TAB      &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         &kp J         &kp K         &kp L         &kp SLASH      &kp ENTER
                // 第 3 行（12 键）- DEL 激活 Navigation 层，↑ 激活 System 层
                &kp LSHFT        &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         &kp M         &kp COMMA     &kp DOT       &lt 6 UP       &lt 8 DEL
                // 第 4 行（11 键）- 右 Alt 激活 Symbols 层
                &lt 7 LCTRL      &kp LGUI      &lt 2 LALT    &lt 1 SPACE   &lt 1 SPACE   &lt 5 C_PP    &lt 9 C_MUTE  &lt 4 RALT    &kp LEFT      &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 1：Number（数字与符号层）- 优化布局
         * ========================================
         */
        layer_number {
            display-name = "Number";
            bindings = <
                // 第 1 行：数字行 + 滚轮上滚
                &trans          &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &msc SCRL_UP
                // 第 2 行：符号优化布局
                &kp CAPS        &kp GRAVE      &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp BSLH       &kp SEMI       &kp APOS       &none          &none          &msc SCRL_DOWN
                // 第 3 行：鼠标移动
                &none           &none          &none          &none          &none          &none          &none          &none          &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP  &mmv MOVE_RIGHT
                // 第 4 行：鼠标点击
                &none           &none          &none          &none          &none          &none          &none          &mkp LCLK      &mkp MCLK      &mkp RCLK      &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 2：Function（功能键层）
         * ========================================
         */
        layer_function {
            display-name = "Function";
            bindings = <
                // 第 1 行：F1-F12
                &kp F11         &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F12
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：导航键
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &kp PAGE_UP    &kp PAGE_UP    &none
                // 第 4 行：导航键
                &none           &none          &none          &none          &kp HOME       &kp PAGE_DOWN  &kp END        &none          &none          &none          &none
            >;
            sensor-bindings = <&encoder_media>;
        };

        /*
         * ========================================
         * 层 3：Button（蓝牙与系统控制层）
         * ========================================
         */
        layer_button {
            display-name = "Button";
            bindings = <
                // 第 1 行：软关机 + 蓝牙断开
                &soft_off       &none          &none          &none          &none          &none          &none          &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &none          &none
                // 第 2 行：蓝牙清除 + 选择设备
                &none           &none          &none          &none          &none          &none          &bt BT_CLR     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &none          &none
                // 第 3 行：清除所有配对、系统复位、进入刷机模式、Studio 解锁
                &none           &none          &none          &none          &none          &none          &bt BT_CLR_ALL &sys_reset     &bootloader    &none          &none          &studio_unlock
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 4：Symbols（符号层）- 已激活
         * ========================================
         * 通过 Base 层右 Alt 按住激活
         */
        layer_symbols {
            display-name = "Symbols";
            bindings = <
                // 第 1 行：特殊符号
                &none           &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &none
                // 第 2 行：括号和引号
                &kp TAB         &kp GRAVE      &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp BSLH       &kp SEMI       &kp APOS       &kp SLASH      &kp BACKSLASH  &none
                // 第 3 行：Shift 符号
                &kp LSHFT       &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 5：Media（媒体层）
         * ========================================
         */
        layer_media {
            display-name = "Media";
            bindings = <
                // 第 1 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：媒体控制
                &none           &none          &none          &none          &none          &none          &none          &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp C_STOP     &none
                // 第 3 行：音量和亮度
                &none           &none          &none          &none          &none          &none          &none          &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_BRI_UP   &kp C_BRI_DN
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&encoder_brightness>;
        };

        /*
         * ========================================
         * 层 6：Navigation（导航层）- 已激活
         * ========================================
         * 通过 Base 层 DEL 按住激活
         */
        layer_navigation {
            display-name = "Navigation";
            bindings = <
                // 第 1 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：导航键
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &kp PAGE_UP    &none          &none
                // 第 4 行：完整导航
                &none           &none          &none          &none          &kp HOME       &kp PAGE_DOWN  &kp END        &none          &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 7：Mouse（鼠标层）
         * ========================================
         */
        layer_mouse {
            display-name = "Mouse";
            bindings = <
                // 第 1 行：鼠标上移 + 滚轮上滚
                &none           &none          &mmv MOVE_UP     &none          &none          &none          &none          &msc SCRL_UP   &none          &none          &none          &none
                // 第 2 行：鼠标左/下/右 + 滚轮下滚
                &none           &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &none         &none          &none          &msc SCRL_DOWN &none          &none          &none          &none
                // 第 3 行：中键
                &none           &none          &none            &none          &none          &none          &none          &mkp MCLK      &none          &none          &none          &none
                // 第 4 行：左键 + 右键
                &none           &none          &none            &none          &none          &mkp LCLK      &mkp RCLK      &none          &none          &none          &none
            >;
            sensor-bindings = <&scroll_ud>;
        };

        /*
         * ========================================
         * 层 8：System（系统层）- 已激活
         * ========================================
         * 通过 Base 层 ↑ 按住激活
         * 注意：devicetree 不支持 LGUI(x) 等嵌套修饰键语法
         * Windows 快捷键可通过 ZMK Studio 在线配置
         */
        layer_system {
            display-name = "System";
            bindings = <
                // 第 1 行：系统功能键
                &none           &kp PSCRN      &kp SLCK       &kp PAUSE_BREAK &kp INSERT     &kp DELETE     &none          &none          &none          &none          &none          &none
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 9：Bluetooth（蓝牙层）
         * ========================================
         */
        layer_bluetooth {
            display-name = "Bluetooth";
            bindings = <
                // 第 1 行：蓝牙设备选择
                &none           &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：蓝牙清除 + 断开
                &none           &none          &none          &none          &none          &none          &none          &bt BT_CLR     &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &none
                // 第 3 行：清除所有配对
                &none           &none          &none          &none          &none          &none          &none          &bt BT_CLR_ALL &none          &none          &none          &none
                // 第 4 行：输出切换
                &none           &out OUT_USB   &out OUT_BLE   &out OUT_TOG   &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&encoder_bt_switch>;
        };
    };

    /*
     * ========================================
     * 组合键 (Combos)
     * ========================================
     */
    combos {
        compatible = "zmk,combos";

        // ===== 基础编辑组合键 =====

        combo_esc {
            timeout-ms = <50>;
            key-positions = <2 3>;           // Q + W = ESC
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_select_all {
            timeout-ms = <50>;
            key-positions = <12 13>;         // A + S = Ctrl+A
            bindings = <&kp LC(A)>;
            layers = <0>;
        };

        combo_undo {
            timeout-ms = <50>;
            key-positions = <24 25>;         // Z + X = Ctrl+Z
            bindings = <&kp LC(Z)>;
            layers = <0>;
        };

        combo_cut {
            timeout-ms = <50>;
            key-positions = <25 26>;         // X + C = Ctrl+X
            bindings = <&kp LC(X)>;
            layers = <0>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <26 27>;         // C + V = Ctrl+C
            bindings = <&kp LC(C)>;
            layers = <0>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <27 28>;         // V + B = Ctrl+V
            bindings = <&kp LC(V)>;
            layers = <0>;
        };

        combo_redo {
            timeout-ms = <50>;
            key-positions = <28 29>;         // B + N = Ctrl+Y
            bindings = <&kp LC(Y)>;
            layers = <0>;
        };

        // ===== 系统组合键 =====

        combo_screenshot {
            timeout-ms = <50>;
            key-positions = <38 39>;         // , + . = PrtSc (截图)
            bindings = <&kp PSCRN>;
            layers = <0>;
        };
    };
};
