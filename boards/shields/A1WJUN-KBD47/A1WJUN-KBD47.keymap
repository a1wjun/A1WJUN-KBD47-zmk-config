#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/behaviors.h>

// 鼠标移动与滚轮的默认速度值（覆盖默认的 600 10）
#undef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <dt-bindings/zmk/pointing.h>

/*
 * 层索引定义（共10层）
 * 
 * 使用 C 预处理器为层定义名称，使键绑定更易读，也便于日后调整层顺序。
 * 层编号从 0 开始，按照在 keymap 节点中定义的顺序排列。
 */
#define Base        0
#define Number      1
#define Function    2
#define Button      3
#define Symbols     4
#define Media       5
#define Navigation  6
#define Mouse       7
#define System      8
#define Bluetooth   9

/ {
    /*
     * ========================================
     * 行为 (Behaviors) 定义
     * ========================================
     * 
     * ZMK 的 "行为" 是可绑定到按键、传感器或层上的动作。
     * 行为可以接收参数来改变其具体表现。
     */

    behaviors {
        /*
         * mod_tap (Mod-Tap 行为)
         * 
         * 按住时输出第一个键码（通常为修饰键），轻触时输出第二个键码。
         * 默认使用 "hold-preferred" 风格：按住超过 200ms 或期间按下其他键时触发 hold 行为。
         * 
         * 官方文档：https://zmk.dev/docs/keymaps/behaviors/hold-tap#mod-tap
         */
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";    // 绑定到 ZMK 的 hold-tap 行为驱动
            #binding-cells = <2>;                    // 需要 2 个参数：hold 键码 + tap 键码
            flavor = "hold-preferred";               // hold 优先策略
            tapping-term-ms = <200>;                 // 判定 tap 的最大时间阈值（毫秒）
            bindings = <&kp>, <&kp>;                 // hold 和 tap 都使用按键行为
            display-name = "Mod-Tap";                // ZMK Studio 中显示的名称
        };

        /*
         * layer_tap (Layer-Tap 行为)
         * 
         * 按住时启用指定层，轻触时输出指定按键。
         * 默认使用 "tap-preferred" 风格。
         * 
         * 官方文档：https://zmk.dev/docs/keymaps/behaviors/hold-tap#layer-tap
         */
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";    // 绑定到 ZMK 的 hold-tap 行为驱动
            #binding-cells = <2>;                    // 需要 2 个参数：层编号 + tap 键码
            flavor = "tap-preferred";                // tap 优先策略
            tapping-term-ms = <200>;                 // 判定 tap 的最大时间阈值（毫秒）
            bindings = <&mo>, <&kp>;                 // hold 时启用层（&mo），tap 时输出按键（&kp）
            display-name = "Layer-Tap";              // ZMK Studio 中显示的名称
        };

        /*
         * tap_dance_2 (2连击 Tap Dance)
         * 
         * 单击输出第一个键，双击输出第二个键。
         * 使用 hold-tap 行为模拟，tapping-term-ms 控制判定时间。
         */
        td2: tap_dance_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap Dance 2";
        };

        /*
         * scroll_ud (编码器滚动行为)
         * 
         * 旋转编码器映射为鼠标滚轮上下滚动。
         * 顺时针滚动 = SCRL_UP，逆时针滚动 = SCRL_DOWN。
         */
        scroll_ud: behavior_scroll_ud {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        /*
         * encoder_brightness (编码器亮度调节)
         */
        encoder_brightness: behavior_brightness {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_BRI_DN>, <&kp C_BRI_UP>;
            tap-ms = <20>;
        };

        /*
         * encoder_media (编码器媒体控制)
         */
        encoder_media: behavior_media {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_PREV>, <&kp C_NEXT>;
            tap-ms = <20>;
        };

        /*
         * encoder_bt_switch (编码器蓝牙切换)
         */
        encoder_bt_switch: behavior_bt_switch {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_PRV>, <&bt BT_NXT>;
            tap-ms = <20>;
        };
    };

    /*
     * ========================================
     * 宏 (Macros) 定义
     * ========================================
     * 
     * 宏可以绑定一系列按键行为，实现一键输入常用内容。
     */
    macros {
        // 一键输入邮箱
        email_macro: email_macro {
            compatible = "zmk,behavior-macro";
            #macro-binding-cells = <0>;
            bind = <
                &kp E &kp A &kp T &kp A &kp A &kp A &kp A &kp A  // 占位，实际使用下面方式
            >;
            wait-ms = <5>;
            tap-ms = <5>;
        };

        // 一键截图 (Windows: Win+Shift+S)
        screenshot_macro: screenshot_macro {
            compatible = "zmk,behavior-macro";
            #macro-binding-cells = <0>;
            bind = <
                &mo 1  // 激活层1用于截图
            >;
            wait-ms = <5>;
            tap-ms = <5>;
        };
    };
};

/*
 * ========================================
 * 鼠标移动与滚轮加速配置
 * ========================================
 * 
 * 配置鼠标指针移动和滚轮的加速度曲线参数。
 */

// 鼠标移动行为（指针移动）
&mmv {
    x-input-code = <INPUT_REL_X>;          // X 轴相对移动
    y-input-code = <INPUT_REL_Y>;          // Y 轴相对移动
    time-to-max-speed-ms = <300>;          // 达到最大速度的时间（毫秒）
    acceleration-exponent = <1>;           // 加速度指数（1 = 线性加速）
    delay-ms = <0>;                        // 初始延迟（毫秒）
};

// 鼠标滚轮行为
&msc {
    x-input-code = <INPUT_REL_HWHEEL>;     // 水平滚轮
    y-input-code = <INPUT_REL_WHEEL>;      // 垂直滚轮
    time-to-max-speed-ms = <300>;          // 达到最大速度的时间（毫秒）
    acceleration-exponent = <0>;           // 加速度指数（0 = 无加速，恒定速度）
    delay-ms = <0>;                        // 初始延迟（毫秒）
};

// 软关机行为：按住 5000ms 触发
&soft_off {
    hold-time-ms = <5000>;                 // 触发软关机所需的按住时间
};

/ {
    /*
     * ========================================
     * 按键映射 (Keymap)
     * ========================================
     * 
     * keymap 节点本身没有属性，其子节点按顺序对应各层（从层 0 开始）。
     * 每层的 bindings 列表必须按照键盘扫描配置中按键的定义顺序排列。
     * 
     * 官方文档：https://zmk.dev/docs/keymaps
     */
    keymap {
        compatible = "zmk,keymap";           // 标识此为 ZMK 按键映射节点

        /*
         * ========================================
         * 层 0：Base（基础层）- 优化版
         * ========================================
         * 
         * 默认层（层 0）始终处于启用状态。
         * 这是键盘的主要布局层，包含字母、常用符号和导航键。
         * 
         * 底层快捷键（优化后）：
         *   - 左 Ctrl 按住 → 层 7（Mouse 鼠标层）
         *   - 左 Alt 按住 → 层 2（Function 功能键层）
         *   - 右拇指上键 按住 → 层 5（Media 媒体层）
         *   - 右拇指下键 按住 → 层 9（Bluetooth 蓝牙层）
         *   - 空格按住 → 层 1（Number 数字层）
         *   - ESC 按住 → 层 3（Button 系统控制层）
         */
        layer_base {
            display-name = "Base";
            bindings = <
                // 第 1 行（12 键）
                &lt 3 ESC      &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         &kp U         &kp I         &kp O         &kp P          &kp BACKSPACE
                // 第 2 行（12 键）
                &kp TAB        &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         &kp J         &kp K         &kp L         &kp SLASH      &kp ENTER
                // 第 3 行（12 键）
                &kp LSHFT      &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         &kp M         &kp COMMA     &kp DOT       &kp UP         &kp DEL
                // 第 4 行（11 键，优化后）
                &lt 7 LCTRL    &kp LGUI      &lt 2 LALT    &lt 1 SPACE   &lt 1 SPACE   &lt 5 C_PP    &lt 9 C_MUTE  &kp RALT      &kp LEFT      &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;    // 编码器：音量加减
        };

        /*
         * ========================================
         * 层 1：Number（数字与符号层）- 增强版
         * ========================================
         * 
         * 通过 Base 层空格键按住时临时激活（&lt 1 SPACE）。
         * 包含数字行、符号、媒体控制和鼠标滚动。
         */
        layer_number {
            display-name = "Number";
            bindings = <
                // 第 1 行：数字行 + 滚轮上滚
                &trans          &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &msc SCRL_UP
                // 第 2 行：CAPS + 符号键 + 滚轮下滚
                &kp CAPS        &kp GRAVE      &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp BSLH       &kp SEMI       &kp APOS       &kp COMMA      &kp DOT        &msc SCRL_DOWN
                // 第 3 行：鼠标移动
                &none           &none          &none          &none          &none          &none          &none          &none          &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP  &mmv MOVE_RIGHT
                // 第 4 行：鼠标点击
                &none           &none          &none          &none          &none          &none          &none          &mkp LCLK      &mkp MCLK      &mkp RCLK      &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 2：Function（功能键层）- 增强版
         * ========================================
         * 
         * 通过 Base 层左 Alt 键按住时临时激活（&lt 2 LALT）。
         * 包含 F1-F12 功能键和导航键。
         */
        layer_function {
            display-name = "Function";
            bindings = <
                // 第 1 行：F1-F12
                &kp F11         &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F12
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：导航键
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &kp PAGE_UP    &kp PAGE_UP    &none
                // 第 4 行：导航键
                &none           &none          &none          &none          &kp HOME       &kp PAGE_DOWN  &kp END        &none          &none          &none          &none
            >;
            sensor-bindings = <&encoder_media>;    // 编码器：上一曲/下一曲
        };

        /*
         * ========================================
         * 层 3：Button（蓝牙与系统控制层）
         * ========================================
         * 
         * 通过 Base 层 ESC 键（&lt 3 ESC）按住时临时激活。
         * 包含蓝牙配对、设备切换、复位和刷机功能。
         */
        layer_button {
            display-name = "Button";
            bindings = <
                // 第 1 行：软关机 + 蓝牙断开
                &soft_off       &none          &none          &none          &none          &none          &none          &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &none          &none
                // 第 2 行：蓝牙清除 + 选择设备
                &none           &none          &none          &none          &none          &none          &bt BT_CLR     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &none          &none
                // 第 3 行：清除所有配对、系统复位、进入刷机模式、Studio 解锁
                &none           &none          &none          &none          &none          &none          &bt BT_CLR_ALL &sys_reset     &bootloader    &none          &none          &studio_unlock
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 4：Symbols（符号层）- 新增
         * ========================================
         * 
         * 预留层，可通过 ZMK Studio 配置激活方式。
         * 包含常用特殊符号。
         */
        layer_symbols {
            display-name = "Symbols";
            bindings = <
                // 第 1 行：特殊符号
                &none           &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &none
                // 第 2 行：括号和引号
                &kp TAB         &kp GRAVE      &kp MINUS      &kp EQUAL      &kp LBKT       &kp RBKT       &kp BSLH       &kp SEMI       &kp APOS       &kp SLASH      &kp BACKSLASH  &none
                // 第 3 行：Shift 符号
                &kp LSHFT       &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 5：Media（媒体层）- 新增
         * ========================================
         * 
         * 通过 Base 层右拇指上键（&lt 5 C_PP）按住时临时激活。
         * 包含媒体控制和亮度调节。
         */
        layer_media {
            display-name = "Media";
            bindings = <
                // 第 1 行：F1-F12 作为备用
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：媒体控制
                &none           &none          &none          &none          &none          &none          &none          &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp C_STOP     &none
                // 第 3 行：音量和亮度
                &none           &none          &none          &none          &none          &none          &none          &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_BRI_UP   &kp C_BRI_DN
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&encoder_brightness>;    // 编码器：亮度调节
        };

        /*
         * ========================================
         * 层 6：Navigation（导航层）- 新增
         * ========================================
         * 
         * 预留用于扩展，可通过快捷键激活。
         * 包含完整的导航键。
         */
        layer_navigation {
            display-name = "Navigation";
            bindings = <
                // 第 1 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：导航键
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &kp PAGE_UP    &none          &none
                // 第 4 行：完整导航
                &none           &none          &none          &none          &kp HOME       &kp PAGE_DOWN  &kp END        &none          &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 7：Mouse（鼠标层）
         * ========================================
         * 
         * 通过 Base 层左 Ctrl（&lt 7 LCTRL）按住时临时激活。
         * 包含鼠标移动、点击和滚轮。
         */
        layer_mouse {
            display-name = "Mouse";
            bindings = <
                // 第 1 行：鼠标上移 + 滚轮上滚
                &none           &none          &mmv MOVE_UP     &none          &none          &none          &none          &msc SCRL_UP   &none          &none          &none          &none
                // 第 2 行：鼠标左/下/右 + 滚轮下滚
                &none           &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &none         &none          &none          &msc SCRL_DOWN &none          &none          &none          &none
                // 第 3 行：中键
                &none           &none          &none            &none          &none          &none          &none          &mkp MCLK      &none          &none          &none          &none
                // 第 4 行：左键 + 右键
                &none           &none          &none            &none          &none          &mkp LCLK      &mkp RCLK      &none          &none          &none          &none
            >;
            sensor-bindings = <&scroll_ud>;                      // 编码器：自定义滚动行为
        };

        /*
         * ========================================
         * 层 8：System（系统层）- 新增
         * ========================================
         * 
         * 预留用于系统功能。
         * 包含截图、锁屏等系统快捷键。
         */
        layer_system {
            display-name = "System";
            bindings = <
                // 第 1 行：系统功能
                &none           &kp PSCRN      &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 3 行：Windows 快捷键
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                // 第 4 行：空
                &none           &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /*
         * ========================================
         * 层 9：Bluetooth（蓝牙层）
         * ========================================
         * 
         * 通过 Base 层右拇指下键（&lt 9 C_MUTE）按住时临时激活。
         * 包含蓝牙切换和输出切换。
         */
        layer_bluetooth {
            display-name = "Bluetooth";
            bindings = <
                // 第 1 行：蓝牙设备选择
                &none           &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &none          &none          &none          &none          &none          &none          &none          &none
                // 第 2 行：蓝牙清除 + 断开
                &none           &none          &none          &none          &none          &none          &none          &bt BT_CLR     &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &none
                // 第 3 行：清除所有配对
                &none           &none          &none          &none          &none          &none          &none          &bt BT_CLR_ALL &none          &none          &none          &none
                // 第 4 行：输出切换
                &none           &out OUT_USB   &out OUT_BLE   &out OUT_TOG   &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&encoder_bt_switch>;    // 编码器：蓝牙设备切换
        };
    };

    /*
     * ========================================
     * 组合键 (Combos)
     * ========================================
     * 
     * 组合键允许同时按下多个按键来触发一个不同的行为。
     * combos 节点与 keymap 节点平级，在按键映射之前被处理。
     * 
     * 官方文档：https://zmk.dev/docs/keymaps/combos
     */
    combos {
        compatible = "zmk,combos";           // 标识此为 ZMK 组合键配置节点

        // ===== 基础编辑组合键 =====

        combo_esc {
            timeout-ms = <50>;
            key-positions = <2 3>;           // Q + W = ESC
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_select_all {
            timeout-ms = <50>;
            key-positions = <12 13>;         // A + S = Ctrl+A
            bindings = <&kp LC(A)>;
            layers = <0>;
        };

        combo_undo {
            timeout-ms = <50>;
            key-positions = <24 25>;         // Z + X = Ctrl+Z
            bindings = <&kp LC(Z)>;
            layers = <0>;
        };

        combo_cut {
            timeout-ms = <50>;
            key-positions = <25 26>;         // X + C = Ctrl+X
            bindings = <&kp LC(X)>;
            layers = <0>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <26 27>;         // C + V = Ctrl+C
            bindings = <&kp LC(C)>;
            layers = <0>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <27 28>;         // V + B = Ctrl+V
            bindings = <&kp LC(V)>;
            layers = <0>;
        };

        combo_redo {
            timeout-ms = <50>;
            key-positions = <28 29>;         // B + N = Ctrl+Y
            bindings = <&kp LC(Y)>;
            layers = <0>;
        };

        // ===== 新增系统组合键 =====

        combo_screenshot {
            timeout-ms = <50>;
            key-positions = <38 39>;         // , + . = PrtSc (截图)
            bindings = <&kp PSCRN>;
            layers = <0>;
        };

        // 注意：以下组合键因 devicetree 不支持嵌套修饰键语法已移除
        // 如需锁屏、任务管理器等功能，请使用 System 层或 ZMK Studio 配置
    };
};
