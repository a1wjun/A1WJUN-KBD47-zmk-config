#include <dt-bindings/zmk/matrix_transform.h>
#include "A1WJUN-KBD47.dtsi"   // 已包含 physical_layouts.dtsi，避免重复 include

/ {
    // ========== 矩阵变换 ==========
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11)
        >;
    };

    // ========== GPIO 扫描驱动 ==========
    // wakeup-source：睡眠/软关机后，按键触发 GPIO 中断即可唤醒 MCU（机械轴唤醒）
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        status = "okay";
        wakeup-source;                              // 整个 kscan 作为唤醒源，覆盖所有 row/col GPIO
        diode-direction = "col2row";

        // 去抖 5ms，与 .conf 中 ZMK_KSCAN_DEBOUNCE_*_MS=5 保持一致
        // 机械轴适用，量产批次更稳定，避免双击
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        debounce-scan-period-ms = <1>;

        col-gpios
           = <&pro_micro 21 GPIO_ACTIVE_HIGH>  // COL0
            , <&pro_micro 20 GPIO_ACTIVE_HIGH> // COL1
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // COL2
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // COL3
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> // COL4
            , <&pro_micro 14 GPIO_ACTIVE_HIGH> // COL5
            , <&pro_micro  9 GPIO_ACTIVE_HIGH> // COL6
            , <&pro_micro  8 GPIO_ACTIVE_HIGH> // COL7
            , <&pro_micro  7 GPIO_ACTIVE_HIGH> // COL8
            , <&pro_micro  6 GPIO_ACTIVE_HIGH> // COL9
            , <&gpio0 8 GPIO_ACTIVE_HIGH>      // COL10
            , <&gpio0 6 GPIO_ACTIVE_HIGH>      // COL11
            ;

        // ROW GPIO 作为输入，被 kscan0 wakeup-source 覆盖，按键可唤醒睡眠
        row-gpios
            = <&pro_micro  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW0
            , <&pro_micro  5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW1
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW2
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW3
            ;
    };

    // ========== 旋转编码器 ==========
    encoder0: encoder_0 {
        compatible = "alps,ec11";
        status = "okay";
        a-gpios = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <20>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <10>;
    };

    // ========== ZMK Studio 支持 ==========
    studio: studio {
        compatible = "zmk,studio";
        layout = <&physical_layout_0>;
    };

    // ========== chosen 节点 ==========
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout_0;
        zmk,sensors = &sensors;
        // 电池：继承 nice_nano_v2 板级自带的 vbatt (zmk,battery-nrf-vddh)
        // 无需额外定义，VDDH 直接读电池电压 → 真实电量通过 BT_BAS 上报
    };

    // ========== 自定义行为 ==========
    behaviors {
        studio_unlock: studio_unlock {
            compatible = "zmk,behavior-studio-unlock";
            #binding-cells = <0>;
        };
    };

    // ========== 物理布局 ==========
    physical_layout_0: physical_layout_0 {
        status = "okay";
        transform = <&default_transform>;
    };
};
